---
import MovieCard from './MovieCard.astro'
import type { Movie } from '../lib/types'

interface Props {
  slug: string
  name: string
  items: Movie[]
}

const { slug, name, items } = Astro.props

const isEmpty = items.length === 0
---

<section class="mt-10">
  <div class="liquid-glass rounded-3xl px-4 sm:px-6 py-5">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-sm font-semibold text-text-primary">{name}</h2>
      {
        isEmpty ? (
          <span class="text-[11px] text-text-muted">Chưa có phim</span>
        ) : (
          <a
            href={`/the-loai/${slug}`}
            class="group text-[11px] text-text-muted hover:text-white transition-colors"
          >
            Xem thêm <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
        )
      }
    </div>
    {
      isEmpty ? (
        <div class="py-10 flex flex-col items-center justify-center text-center">
          <div class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-text-muted" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18 3v2h-2V3H8v2H6V3H4v18h2v-2h2v2h8v-2h2v2h2V3h-2zM8 17H6v-2h2v2zm0-4H6v-2h2v2zm0-4H6V7h2v2zm10 8h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2V7h2v2z" />
            </svg>
          </div>
          <p class="text-text-muted text-xs">Không thể tải phim thể loại này ngay lúc này</p>
          <a href={`/the-loai/${slug}`} class="mt-3 px-4 py-1.5 rounded-xl glass-tile text-[11px] text-text-secondary hover:text-white transition-colors">
            Xem trang thể loại
          </a>
        </div>
      ) : (
        <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-none snap-x snap-mandatory">
          {
            items.map((movie) => (
              <div class="snap-start shrink-0 w-[160px]">
                <MovieCard movie={movie} />
              </div>
            ))
          }
        </div>
      )
    }
  </div>
</section>
