---
import { CONTACT_EMAIL } from '../lib/site'

const year = new Date().getFullYear()
---

<footer class="mt-16">
  <div class="liquid-glass rounded-none">
    <div class="px-5 sm:px-8 md:px-10 py-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="col-span-2 md:col-span-1">
          <a href="/" class="flex items-center gap-3">
            <img
              src="/logo.png"
              alt="Nô Lệ Làm Phim"
              width="32"
              height="32"
              class="rounded-xl"
            />
            <span class="font-semibold text-sm text-text-primary">
              Nô Lệ Làm Phim
            </span>
          </a>
          <p class="text-xs text-text-muted mt-3 leading-relaxed max-w-48">
            Xem phim đa nền tảng, cập nhật nhanh nhất.
          </p>
        </div>

      <div>
        <h4 class="text-xs font-semibold text-text-muted uppercase tracking-widest mb-4">
          Điều hướng
        </h4>
        <ul class="space-y-3">
          {
            [
              { href: '/', label: 'Trang chủ' },
              { href: '/search', label: 'Tìm kiếm' },
              { href: '/the-loai', label: 'Danh mục' },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-xs text-text-secondary hover:text-white transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-text-muted uppercase tracking-widest mb-4">
          Thể loại
        </h4>
        <ul class="space-y-3">
          {
            [
              { href: '/the-loai/hanh-dong', label: 'Hành động' },
              { href: '/the-loai/tinh-cam', label: 'Tình cảm' },
              { href: '/the-loai/hai-huoc', label: 'Hài hước' },
              { href: '/the-loai/vien-tuong', label: 'Viễn tưởng' },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-xs text-text-secondary hover:text-white transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-text-muted uppercase tracking-widest mb-4">
          Thông tin
        </h4>
        <ul class="space-y-3">
          <li>
            <a href={`mailto:${CONTACT_EMAIL}`} class="text-xs text-text-secondary hover:text-white transition-colors break-all">
              {CONTACT_EMAIL}
            </a>
          </li>
          <li>
            <span class="text-xs text-text-muted">
              Dữ liệu từ vsmov.com
            </span>
          </li>
          <li>
            <span class="text-xs text-text-muted">
              Phiên bản 1.0
            </span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-4 border-t border-white/5 text-center">
      <p class="text-xs text-text-muted">
        &copy; {year} Nô Lệ Làm Phim
      </p>
    </div>
    </div>
  </div>
</footer>
