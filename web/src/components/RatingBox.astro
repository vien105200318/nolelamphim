---
interface Props {
  slug: string
  name?: string
}

const { slug } = Astro.props

const STAR_PATH =
  'M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z'
---

<div
  class="rating-box flex flex-col items-center gap-1 group/rating cursor-pointer"
  data-slug={slug}
  title="Đánh giá phim này"
>
  <div class="flex gap-0.5">
    {
      [1, 2, 3, 4, 5].map((n) => (
        <button
         
          type="button"
          aria-label={`${n} sao`}
          class="rating-star p-0.5 transition-transform duration-150 hover:scale-110"
          data-value={n}
        >
          <svg class="w-5 h-5 star-empty transition-colors duration-150" fill="currentColor" viewBox="0 0 24 24">
            <path d={STAR_PATH} />
          </svg>
        </button>
      ))
    }
  </div>
  <span class="rating-label text-[10px] text-text-muted leading-none">Đánh giá</span>
</div>

<script>
  import { getRatings, saveRating } from '../scripts/store'

  document.querySelectorAll<HTMLElement>('.rating-box').forEach((box) => {
    const slug = box.dataset.slug || ''
    const stars = Array.from(box.querySelectorAll<HTMLButtonElement>('.rating-star'))
    const label = box.querySelector('.rating-label')
    let value = getRatings()[slug] ?? 0

    let hover = 0

    function paint() {
      const display = hover || value
      stars.forEach((star, i) => {
        const svg = star.querySelector('svg')
        if (!svg) return
        const filled = i + 1 <= display
        svg.classList.toggle('star-filled', filled)
        svg.classList.toggle('star-empty', !filled)
      })
    }

    stars.forEach((star) => {
      star.addEventListener('mouseenter', () => {
        hover = Number(star.dataset.value)
        paint()
      })
      star.addEventListener('click', () => {
        value = Number(star.dataset.value)
        saveRating(slug, value)
        if (label) label.textContent = `${value}/5`
        box.title = `Bạn đánh giá ${value}/5`
        paint()
      })
    })

    box.addEventListener('mouseleave', () => {
      hover = 0
      paint()
    })

    if (value) {
      if (label) label.textContent = `${value}/5`
      box.title = `Bạn đánh giá ${value}/5`
    }

    paint()
  })
</script>
