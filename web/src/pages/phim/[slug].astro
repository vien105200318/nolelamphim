---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SimilarMovies from '../../components/SimilarMovies.astro'
import FavoriteButton from '../../components/FavoriteButton.astro'
import EpisodeList from '../../components/EpisodeList.astro'
import Reveal from '../../components/Reveal.astro'
import RatingBox from '../../components/RatingBox.astro'
import ShareButton from '../../components/ShareButton.astro'
import ReportButton from '../../components/ReportButton.astro'
import { getMovieDetail, getMovieEpisodes } from '../../lib/api'
import { SITE_URL } from '../../lib/site'

const slug = Astro.params.slug ?? ''

const [data, epRes] = await Promise.all([
  getMovieDetail(slug).catch(() => ({ status: false, movie: null })),
  getMovieEpisodes(slug),
])

if (!data.status || !data.movie) {
  return Astro.redirect('/404', 404)
}

const movie = data.movie
const episodes = epRes.status ? epRes.episodes : []

const metaTitle = movie.name
const metaDescription = movie.content
  ? movie.content.replace(/<[^>]*>/g, '').slice(0, 160)
  : `Xem phim ${movie.name} ${movie.year ? movie.year : ''} HD VietSub miễn phí.`
const image = movie.poster_url || movie.thumb_url
const metaKeywords = [
  movie.name,
  movie.origin_name,
  ...(Array.isArray(movie.category) ? movie.category.map((c) => c.name) : []),
].filter(Boolean).join(', ')

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Movie',
  name: movie.name,
  alternateName: movie.origin_name,
  description: movie.content ? movie.content.replace(/<[^>]*>/g, '').slice(0, 300) : undefined,
  image: image || undefined,
  url: `${SITE_URL}/phim/${slug}`,
  year: movie.year,
  duration: movie.time,
  genre: Array.isArray(movie.category) ? movie.category.map((c) => c.name) : undefined,
  director: Array.isArray(movie.director) ? movie.director.map((d) => ({ '@type': 'Person', name: d })) : undefined,
  actor: Array.isArray(movie.actor) ? movie.actor.map((a) => ({ '@type': 'Person', name: a })) : undefined,
}

const chips = [movie.year, movie.quality, movie.lang, movie.time, movie.status].filter(Boolean)

let keywordsList: string[] = []
if (movie.keywords) {
  keywordsList = Array.isArray(movie.keywords) ? movie.keywords : movie.keywords.split(', ')
}
---

<BaseLayout title={metaTitle} description={metaDescription} keywords={metaKeywords} ogImage={image}>
  <script is:inline set:html={JSON.stringify(jsonLd)} type="application/ld+json" />

  <div class="px-4 md:px-8 py-6">
    <div class="relative h-[35vh] md:h-[45vh] rounded-2xl overflow-hidden mb-6 glass-frame">
      {
        image ? (
          <img
            src={image}
            alt={movie.name}
            class="w-full h-full object-cover ken-burns"
          />
        ) : (
          <div class="w-full h-full bg-bg-card flex items-center justify-center text-text-muted">
            No image
          </div>
        )
      }
      <div class="absolute inset-0 bg-gradient-to-t from-bg-dark via-bg-dark/30 to-transparent" />
    </div>

    <Reveal>
      <div class="space-y-5">
        <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-3">
          <div class="min-w-0 flex-1 basis-52">
            <h1 class="text-xl sm:text-2xl font-bold text-text-primary">{movie.name}</h1>
            {movie.origin_name && <p class="text-sm text-text-muted mt-1">{movie.origin_name}</p>}
          </div>
          <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
            <RatingBox slug={slug} name={movie.name} />
            <ShareButton slug={slug} name={movie.name} />
            <ReportButton slug={slug} name={movie.name} />
            <FavoriteButton id={movie._id} name={movie.name} slug={slug} thumb={movie.thumb_url || ''} />
          </div>
        </div>

        <div class="flex flex-wrap gap-2">
          {
            chips.map((chip) => (
              <span class="px-3 py-1 rounded-lg glass-chip text-text-secondary text-xs">
                {chip}
              </span>
            ))
          }
          {
            movie.episode_current && (
              <span class="px-3 py-1 rounded-lg bg-gradient-to-r from-[#FF6B9D]/15 to-[#4A9EFF]/15 text-[#FF6B9D] text-xs font-medium">
                {movie.episode_current}
              </span>
            )
          }
        </div>

        {
          movie.content && (
            <div class="content-card px-5 py-4">
              <h3 class="text-sm font-semibold text-text-primary mb-2">Nội dung</h3>
              <p class="text-sm text-text-secondary leading-relaxed">{movie.content}</p>
            </div>
          )
        }

        {
          movie.actor && (
            <div>
              <h3 class="text-sm font-semibold text-text-primary mb-2">Diễn viên</h3>
              <p class="text-sm text-text-secondary leading-relaxed">
                {Array.isArray(movie.actor) ? movie.actor.join(', ') : movie.actor}
              </p>
            </div>
          )
        }

        {
          movie.director && (
            <div>
              <h3 class="text-sm font-semibold text-text-primary mb-2">Đạo diễn</h3>
              <p class="text-sm text-text-secondary leading-relaxed">
                {Array.isArray(movie.director) ? movie.director.join(', ') : movie.director}
              </p>
            </div>
          )
        }

        {
          movie.category && movie.category.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {
                Array.isArray(movie.category) &&
                  movie.category.map((cat) => (
                    <a
                     
                      href={`/the-loai/${typeof cat === 'string' ? cat : cat.slug}`}
                      class="px-3 py-1.5 rounded-xl glass-tile text-text-muted text-xs"
                    >
                      {typeof cat === 'string' ? cat : cat.name}
                    </a>
                  ))
              }
            </div>
          )
        }

        {
          keywordsList.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {
                keywordsList.slice(0, 10).map((kw) => (
                  <span class="px-2.5 py-1 rounded-lg glass-chip text-text-muted text-[10px]">
                    {kw}
                  </span>
                ))
              }
            </div>
          )
        }

        {
          episodes.length > 0 && (
            <div>
              <h3 class="text-sm font-semibold text-text-primary mb-3">Tập phim</h3>
              <EpisodeList slug={slug} servers={episodes} />
            </div>
          )
        }

        <SimilarMovies categories={movie.category ?? []} excludeSlug={slug} />

        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl glass-tile text-text-secondary text-xs"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
          </svg>
          Quay lại
        </a>
      </div>
    </Reveal>
  </div>
</BaseLayout>
