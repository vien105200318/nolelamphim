---
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroCarousel from '../components/HeroCarousel.astro'
import ThemeSection from '../components/ThemeSection.astro'
import ContinueWatching from '../components/ContinueWatching.astro'
import CategorySection from '../components/CategorySection.astro'
import MovieGrid from '../components/MovieGrid.astro'
import MovieCard from '../components/MovieCard.astro'
import Reveal from '../components/Reveal.astro'
import { getNewMovies, getSubteam, getMoviesByCategory } from '../lib/api'
import { imgUrl } from '../lib/img'
import { HERO_IMAGE_LIMIT } from '../lib/constants'

export const prerender = true
export const revalidate = 60

const [newMovies, subteam] = await Promise.all([
  getNewMovies().catch(() => ({ status: false, items: [], pagination: undefined })),
  getSubteam().catch(() => ({ status: false, items: [], pagination: undefined })),
])

const categorySlugs = [
  { slug: 'hanh-dong', name: 'Hành Động' },
  { slug: 'lang-man', name: 'Lãng Mạn' },
  { slug: 'kinh-di', name: 'Kinh Dị' },
  { slug: 'hoat-hinh', name: 'Hoạt Hình' },
  { slug: 'hai', name: 'Hài' },
  { slug: 'co-trang', name: 'Cổ Trang' },
]

const categoryItems = await Promise.all(
  categorySlugs.map((c) =>
    getMoviesByCategory(c.slug, { limit: 12 })
      .then((d) => ({ slug: c.slug, name: c.name, items: d.items }))
      .catch(() => ({ slug: c.slug, name: c.name, items: [] })),
  ),
)

const heroMovies = newMovies.items.slice(0, HERO_IMAGE_LIMIT)
const heroImage = heroMovies[0] ? heroMovies[0].poster_url || heroMovies[0].thumb_url : ''
---

<BaseLayout>
  <Fragment slot="head">
    {heroImage && <link rel="preload" as="image" href={imgUrl(heroImage, 1600)} fetchpriority="high" />}
  </Fragment>
  <div class="px-4 md:px-8">
    {
      heroMovies.length > 0 ? (
        <section class="mt-6">
          <div class="flex items-center justify-between mb-3 gap-3">
            <p class="text-text-muted text-xs">Khám phá kho phim chiếu rạp, bộ, lẻ mới nhất</p>
            <a
              id="random-movie"
              href="/api/random"
              class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-xl glass-tile text-text-secondary text-xs font-medium hover:text-white transition-colors"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 7h4l6 10h4M3 7l-1-1M10 11l2 2m7-6l3-3m0 0l-3-3m3 3H16m5 10l-3 3m0-3l3-3m-3 3h-3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Phim bất kỳ
            </a>
          </div>
          <Reveal>
            <HeroCarousel movies={heroMovies} />
          </Reveal>
        </section>
      ) : (
        <div class="py-20 flex flex-col items-center justify-center">
          <div class="content-card px-8 py-12 flex flex-col items-center">
            <div class="w-12 h-12 rounded-full bg-white/5 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-text-muted" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
              </svg>
            </div>
            <p class="text-text-secondary text-sm">Không thể tải dữ liệu phim mới</p>
            <p class="text-text-muted text-xs mt-1 mb-4">Kiểm tra kết nối mạng rồi thử lại</p>
            <a href="/" class="px-5 py-2 rounded-xl bg-white/10 text-white text-sm font-medium hover:bg-white/20 transition-colors">
              Tải lại
            </a>
          </div>
        </div>
      )
    }
  </div>

  <ThemeSection />

  <div class="px-4 md:px-8">
    <ContinueWatching />

    {
      subteam.items.length > 0 && (
        <Reveal delay={80}>
          <section class="mt-10 cv-auto">
            <div class="liquid-glass rounded-3xl px-4 sm:px-6 py-5">
              <h2 class="text-sm font-semibold text-text-primary mb-4">Subteam</h2>
              <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-none snap-x snap-mandatory">
                {
                  subteam.items.slice(0, 10).map((movie) => (
                    <div class="snap-start shrink-0 w-[160px]">
                      <MovieCard movie={movie} dot="hot" />
                    </div>
                  ))
                }
              </div>
            </div>
          </section>
        </Reveal>
      )
    }

    {
      categoryItems.map((c, i) => (
        <Reveal delay={40 + i * 20}>
          <CategorySection slug={c.slug} name={c.name} items={c.items} className={i > 0 ? 'cv-auto' : ''} />
        </Reveal>
      ))
    }

    {
      newMovies.items.length > 0 && (
        <Reveal delay={120}>
          <section class="mt-10 cv-auto">
            <div class="liquid-glass rounded-3xl px-4 sm:px-6 py-5">
              <h2 class="text-sm font-semibold text-text-primary mb-4">Phim mới cập nhật</h2>
              <MovieGrid initialItems={newMovies.items} path="/danh-sach/phim-moi-cap-nhat" dot="new" totalPages={newMovies.pagination?.totalPages} />
            </div>
          </section>
        </Reveal>
      )
    }
  </div>
</BaseLayout>
