---
import BaseLayout from '../layouts/BaseLayout.astro'
import SearchClient from '../components/SearchClient.astro'
import { searchMovies, getNewMovies } from '../lib/api'
import { SEARCH_LIMIT } from '../lib/constants'
import type { Movie, ListResponse } from '../lib/types'

const q = Astro.url.searchParams.get('q') ?? ''

const emptyMovieList: ListResponse<Movie> = { status: false, items: [] }

let initialResults = []
let initialLabel = ''
let initialTotalPages = 1

if (q.trim()) {
  const data = await searchMovies(q.trim(), 1, SEARCH_LIMIT).catch(() => emptyMovieList)
  initialResults = data.items ?? []
  initialLabel = `Kết quả cho "${q.trim()}"`
  initialTotalPages = Number(data.pagination?.totalPages) || 1
} else {
  const data = await getNewMovies(1).catch(() => emptyMovieList)
  initialResults = data.items ?? []
  initialLabel = 'Phim mới nhất'
  initialTotalPages = Number(data.pagination?.totalPages) || 1
}
---

<BaseLayout title="Tìm kiếm phim" description="Tìm kiếm phim theo từ khoá, thể loại, quốc gia, năm tại Nô Lệ Làm Phim.">
  <SearchClient initialQuery={q} initialResults={initialResults} initialLabel={initialLabel} initialTotalPages={initialTotalPages} />
</BaseLayout>
