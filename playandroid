#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

show_help() {
  echo "Usage: ./playandroid [options]"
  echo ""
  echo "Options:"
  echo "  --Pixel8        Run on Pixel 8 emulator (mobile flavor)"
  echo "  --TV            Run on Android TV emulator (androidTv flavor)"
  echo "  --build         Only build APK, don't install/run"
  echo "  --install       Build + install (don't launch)"
  echo "  -h, --help      Show this help"
  echo ""
  echo "Examples:"
  echo "  ./playandroid --Pixel8          # build + run on Pixel 8"
  echo "  ./playandroid --TV               # build + run on Android TV"
  echo "  ./playandroid --Pixel8 --build   # only build mobile APK"
  echo "  ./playandroid --TV --install     # build + install TV APK"
}

TARGET=""
MODE="run"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --Pixel8)  TARGET="mobile" ;;
    --TV)      TARGET="androidTv" ;;
    --build)   MODE="build" ;;
    --install) MODE="install" ;;
    -h|--help) show_help; exit 0 ;;
    *) echo "Unknown option: $1"; show_help; exit 1 ;;
  esac
  shift
done

if [[ -z "$TARGET" ]]; then
  echo "Error: Missing target. Use --Pixel8 or --TV"
  show_help
  exit 1
fi

if [[ "$TARGET" == "mobile" ]]; then
  DEVICE="pixel_8"
  FLAVOR="mobile"
elif [[ "$TARGET" == "androidTv" ]]; then
  DEVICE="Android_TV"
  FLAVOR="androidTv"
fi

if [[ "$MODE" == "build" ]]; then
  echo "→ Building $FLAVOR APK..."
  flutter build apk --flavor "$FLAVOR" --release
  echo "✓ APK built: build/app/outputs/flutter-apk/app-$FLAVOR-release.apk"
  exit 0
fi

echo "→ Looking for $DEVICE emulator..."
DEVICE_SERIAL=""
for serial in $(adb devices | grep -E "emulator-[0-9]+" | awk '{print $1}'); do
  name=$(adb -s "$serial" emu avd name 2>/dev/null | head -1)
  if [[ "$name" == "$DEVICE" ]]; then
    DEVICE_SERIAL="$serial"
    break
  fi
done

if [[ -z "$DEVICE_SERIAL" ]]; then
  echo "  $DEVICE emulator not running. Starting it..."
  "$ANDROID_HOME/emulator/emulator" -avd "$DEVICE" -netdelay none -netspeed full &>/tmp/emulator-$DEVICE.log &
  sleep 5
  adb wait-for-device 2>/dev/null
  DEVICE_SERIAL=$(adb devices | grep "emulator-" | awk '{print $1}' | head -1)
  echo "  Waiting for boot..."
  while [[ "$(adb -s "$DEVICE_SERIAL" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" != "1" ]]; do
    sleep 2
  done
  echo "  Booted!"
fi

echo "→ Building $FLAVOR APK..."
flutter build apk --flavor "$FLAVOR" --release

APK="build/app/outputs/flutter-apk/app-$FLAVOR-release.apk"
echo "→ Installing on $DEVICE ($DEVICE_SERIAL)..."
adb -s "$DEVICE_SERIAL" install -r "$APK"

if [[ "$MODE" == "run" ]]; then
  PKG=$(grep "applicationId" android/app/build.gradle.kts | head -1 | grep -oE '"[^"]*"' | tr -d '"' || echo "com.example.nolelamphim")
  if [[ "$FLAVOR" == "androidTv" ]]; then
    PKG="com.nolelamphim.tvreview"
  fi
  echo "→ Launching $PKG..."
  adb -s "$DEVICE_SERIAL" shell am start -n "$PKG/com.example.nolelamphim.MainActivity"
  echo "✓ Done!"
fi
